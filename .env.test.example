# Deel D.4 — copy to .env.test and fill in. Never commit the real file.
# Build with: vite build --mode test   (or npm run dev, which defaults to test)

VITE_APP_ENV=test

VITE_SUPABASE_URL=https://<test-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<test-anon-key>

# D.7 — every outgoing mail in test is redirected here, with the original
# recipient in the subject. Comma-separated; the first address is the redirect
# target, the whole list is the allowed-recipient whitelist.
VITE_MAIL_TEST_WHITELIST=jouw.adres@voorbeeld.be

# D.5 — the TEST banner is on whenever VITE_APP_ENV is not "production".
# This flag only exists to screenshot the app without the banner.
VITE_HIDE_TEST_BANNER=false
